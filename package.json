{
  "name": "anchev-films",
  "version": "1.0.0",
  "private": true,
  "description": "Premium cinematic landing page for a video production company",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server.js",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "lint": "eslint server.js src tests scripts/*.mjs playwright.config.js public/scripts/console.js public/scripts/app.js \"public/scripts/modules/{localization,language,cinema,service-pages,contact,content-markup,experience,projects,about,ui}.js\"",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/gfs-didot": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "lucide": "^1.56.0",
    "multer": "^2.4.0",
    "otpauth": "^9.5.2",
    "quill": "2.0.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0"
  }
}
